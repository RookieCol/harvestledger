# =============================================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env`: it is in .gitignore for a reason.
# =============================================================================

# --- Messaging (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_HOST=rabbitmq:5672

RABBITMQ_AUTH_QUEUE=auth_queue
RABBITMQ_FARMS_QUEUE=farms_queue
RABBITMQ_TRACING_QUEUE=tracing_queue

# --- Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=harvestledger
POSTGRES_URI=postgresql://user:password@postgres:5432/harvestledger

# Run pending TypeORM migrations on startup. Enabled for a single service
# (auth) so the services don't race to migrate; keep this false elsewhere.
DB_RUN_MIGRATIONS=false

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password

# --- MongoDB (append-only traceability event history) ---
MONGO_URI=mongodb://mongo:27017/harvestledger

# --- Redis (idempotency, refresh-token revocation, rate limiting, cache) ---
REDIS_URL=redis://redis:6379

# --- Authentication ---
# Generate long random values: `openssl rand -hex 32`
JWT_SECRET=replace_with_a_random_value
JWT_REFRESH_SECRET=replace_with_another_random_value

# --- Image storage (AWS S3) ---
# Local dev runs against the `minio` container (S3-compatible), defaults below
# work out of the box. For real AWS, drop/empty S3_ENDPOINT and set real keys.
S3_REGION=us-east-1
S3_BUCKET=harvestledger-bucket
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://minio:9000

# --- Gateway CORS (comma-separated allowlist; empty = same-origin only) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (used to build links inside transactional emails) ---
FRONTEND_URL=http://localhost:3000

# --- Transactional email (password recovery) ---
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_IGNORE_TLS=true
MAIL_USER=
MAIL_PASS=

# --- Initial administrator account (seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
