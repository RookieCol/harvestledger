# =============================================================================
# Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees el `.env` real: está en .gitignore por una razón.
# =============================================================================

# --- Mensajería (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_HOST=rabbitmq:5672

RABBITMQ_AUTH_QUEUE=auth_queue
RABBITMQ_FARMS_QUEUE=farms_queue
RABBITMQ_TRACING_QUEUE=tracing_queue

# --- Base de datos ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=harvestledger
POSTGRES_URI=postgresql://user:password@postgres:5432/harvestledger

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password

# --- Autenticación ---
# Genera valores largos y aleatorios: `openssl rand -hex 32`
JWT_SECRET=cambia_esto_por_un_valor_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_valor_aleatorio

# --- Almacenamiento de imágenes (AWS S3) ---
S3_REGION=us-east-1
S3_BUCKET=harvestledger-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Correo transaccional (recuperación de contraseña) ---
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_IGNORE_TLS=true
MAIL_USER=
MAIL_PASS=

# --- IPFS (Pinata) — metadata de trazabilidad ---
PINATA_JWT=
PINATA_GATEWAY=

# --- Blockchain (Polygon) — acuñación del NFT de cosecha ---
# ADVERTENCIA: WALLET_PRIVATE_KEY controla la wallet que firma los mints.
# Trátala como una credencial de producción. Usa una wallet dedicada con
# fondos mínimos y jamás la escribas en el código fuente.
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/TU_API_KEY
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Cuenta de administrador inicial (seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
