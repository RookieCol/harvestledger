# =============================================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env`: it is in .gitignore for a reason.
# =============================================================================

# --- Messaging (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_HOST=rabbitmq:5672

RABBITMQ_AUTH_QUEUE=auth_queue
RABBITMQ_FARMS_QUEUE=farms_queue
RABBITMQ_TRACING_QUEUE=tracing_queue

# --- Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=harvestledger
POSTGRES_URI=postgresql://user:password@postgres:5432/harvestledger

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password

# --- Authentication ---
# Generate long random values: `openssl rand -hex 32`
JWT_SECRET=replace_with_a_random_value
JWT_REFRESH_SECRET=replace_with_another_random_value

# --- Image storage (AWS S3) ---
S3_REGION=us-east-1
S3_BUCKET=harvestledger-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend (used to build links inside transactional emails) ---
FRONTEND_URL=http://localhost:3000

# --- Transactional email (password recovery) ---
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_IGNORE_TLS=true
MAIL_USER=
MAIL_PASS=

# --- IPFS (Pinata) — traceability metadata ---
PINATA_JWT=
PINATA_GATEWAY=

# --- Blockchain (Polygon) — harvest NFT minting ---
# WARNING: WALLET_PRIVATE_KEY controls the wallet that signs the mints.
# Treat it as a production credential. Use a dedicated wallet holding
# minimal funds, and never write it into the source code.
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Initial administrator account (seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
